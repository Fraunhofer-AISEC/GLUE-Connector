{
    "cmcAddr": "/tmp/cmcd.sock",
    "provisionMode": "est",
    "provisionAuth": [ "attestation" ],
    "provisionAddr": "https://estserver:9000/",
    "metadata": [
        "file:///metadata"
    ],
    "drivers": [ "tpm" ],
    "keyConfig": "EC256",
    "hashAlg": "SHA256",
    "api": "socket",
    "policyEngine": "js",
    "policyOverwrite": false,
    "logLevel": "trace",
    "storage": "/tmp/cmc-internal/",
    "cache": "/tmp/cmc-cache/",
    "peerCache": "/tmp/cmc-peer-cache",
    "measurementLogs": true,
    "estTlsCas": [
        "/pki/ca-cert.pem"
    ],
    "identityCas": [
        "/pki/ca-cert.pem"
    ],
    "metadataCas": [
        "/pki/ca-cert.pem"
    ]
}
